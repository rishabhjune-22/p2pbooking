<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootView"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/booking_list_bg">

    <View
        style="@style/RoomAvailabilityHeaderDimensions"
        android:layout_width="match_parent"
        android:background="@drawable/bg_create_booking_header" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/space_12">

        <androidx.appcompat.widget.Toolbar
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_56"
            android:layout_marginTop="@dimen/space_20"
            android:background="@android:color/transparent">

            <ImageView
                android:id="@+id/ivBack"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:contentDescription="Back"
                android:padding="@dimen/space_12"
                android:src="@drawable/back_svgrepo_com"
                app:tint="@color/white" />

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Room Availability"
                android:textColor="@color/white"
                android:textSize="@dimen/text_20"
                android:textStyle="bold" />

        </androidx.appcompat.widget.Toolbar>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_20"
            android:background="@drawable/bg_detail_card"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_12">

            <ImageButton
                android:id="@+id/btnPreviousMonth"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:background="@android:color/transparent"
                android:contentDescription="Previous month"
                android:padding="@dimen/space_12"
                android:src="@drawable/back_svgrepo_com"
                app:tint="@color/detail_text_primary" />

            <TextView
                android:id="@+id/tvMonthYear"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="May 2026"
                android:textColor="@color/detail_text_primary"
                android:textSize="@dimen/text_17"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/btnNextMonth"
                android:layout_width="@dimen/space_48"
                android:layout_height="@dimen/space_48"
                android:background="@android:color/transparent"
                android:contentDescription="Next month"
                android:padding="@dimen/space_12"
                android:rotation="180"
                android:src="@drawable/back_svgrepo_com"
                app:tint="@color/detail_text_primary" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:orientation="horizontal">



        </LinearLayout>

        <ProgressBar
            android:id="@+id/progressBarAvailability"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_16"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvAvailabilityMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="@dimen/space_12"
            android:textColor="@color/detail_text_secondary"
            android:textSize="@dimen/text_14"
            android:visibility="gone" />
        <LinearLayout
            android:id="@+id/layoutHostelToggle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:background="@drawable/bg_detail_card"
            android:orientation="horizontal"
            android:padding="@dimen/space_6">

            <TextView
                android:id="@+id/tvToggleBeta"
                style="@style/AvailabilityToggleSelected"
                android:text="Beta" />

            <TextView
                android:id="@+id/tvToggleGamma"
                style="@style/AvailabilityToggleUnselected"
                android:text="Gamma" />

            <TextView
                android:id="@+id/tvToggleDelta"
                style="@style/AvailabilityToggleUnselected"
                android:text="Delta" />

        </LinearLayout>
        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipeRefreshAvailability"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_12"
            android:layout_weight="1">
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvAvailabilityGroups"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/space_12"
            android:layout_weight="1"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingBottom="@dimen/space_24"
            android:scrollbars="none" />
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

</FrameLayout>
