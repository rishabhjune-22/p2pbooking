<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dayContainer"
    android:layout_width="match_parent"
    android:layout_height="@dimen/space_72"
    android:layout_margin="@dimen/space_4"
    android:background="@drawable/bg_detail_card"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="@dimen/space_4">

    <TextView
        android:id="@+id/tvDayNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="25"
        android:textColor="@color/detail_text_primary"
        android:textSize="@dimen/text_15"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAvailabilityCount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_4"
        android:gravity="center"
        android:text="12/12"
        android:textColor="@color/detail_title"
        android:textSize="@dimen/text_12"
        android:textStyle="bold" />

</LinearLayout>
