<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:id="@+id/layoutSplashContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_32"
        android:layout_marginEnd="@dimen/space_32"
        android:background="@drawable/bg_detail_card"
        android:elevation="@dimen/space_8"
        android:gravity="center"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_28"
        android:paddingTop="@dimen/space_36"
        android:paddingEnd="@dimen/space_28"
        android:paddingBottom="@dimen/space_36"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <!-- IIT BHILAI LOGO -->
        <ImageView
            android:id="@+id/imgIitLogo"
            android:layout_width="@dimen/space_76"
            android:layout_height="@dimen/space_76"
            android:contentDescription="IIT Bhilai Logo"
            android:scaleType="fitCenter"
            android:src="@drawable/iit_bhilai_logo" />

        <!-- IIT BHILAI TEXT -->
        <TextView
            android:id="@+id/tvInstituteName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            android:gravity="center"
            android:text="IIT Bhilai"
            android:textColor="@color/detail_text_primary"
            android:textSize="@dimen/text_18"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvInstituteSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_3"
            android:gravity="center"
            android:text="Indian Institute of Technology Bhilai"
            android:textColor="@color/detail_text_secondary"
            android:textSize="@dimen/text_13" />

        <View
            android:layout_width="@dimen/space_54"
            android:layout_height="@dimen/space_4"
            android:layout_marginTop="@dimen/space_18"
            android:background="@color/info_blue" />

        <!-- ROOM BOOKING ICON -->
        <ImageView
            android:id="@+id/imgLogo"
            android:layout_width="@dimen/space_86"
            android:layout_height="@dimen/space_86"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_icon_circle"
            android:contentDescription="Room Booking Logo"
            android:padding="@dimen/space_18"
            android:src="@drawable/hostel_svgrepo_com"
            app:tint="@color/white" />

        <!-- APP TITLE -->
        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_22"
            android:gravity="center"
            android:text="Room Booking"
            android:textColor="@color/detail_text_primary"
            android:textSize="@dimen/text_28"
            android:textStyle="bold" />

        <!-- APP SUBTITLE -->
        <TextView
            android:id="@+id/tvSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_8"
            android:gravity="center"
            android:text="Manage visitor rooms easily"
            android:textColor="@color/detail_text_secondary"
            android:textSize="@dimen/text_14" />

    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>