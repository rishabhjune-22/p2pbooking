<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E88E5">

    <!-- Header Gradient Background -->
    <View
        android:id="@+id/vHeaderBg"
        android:layout_width="match_parent"
        android:layout_height="260dp"
        android:background="@drawable/bg_resolve_conflict_header"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Back Arrow (Using default Android icon or custom, but let's use a standard one and tint it white) -->
    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="32dp"
        android:layout_height="32dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="32dp"
        android:src="?attr/homeAsUpIndicator"
        app:tint="#FFFFFF"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Title -->
    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="32dp"
        android:layout_marginTop="24dp"
        android:layout_marginEnd="32dp"
        android:text="Resolve Booking Conflict"
        android:textColor="#FFFFFF"
        android:textSize="24sp"
        android:textStyle="bold"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack" />

    <!-- Subtitle -->
    <TextView
        android:id="@+id/tvSubtitleDesc"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        android:text="Choose how you want to resolve the conflict"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        android:gravity="center"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/tvTitle" />

    <!-- Round Container for content -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/bg_rounded_top"
        android:padding="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvSubtitleDesc"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- LOCAL CARD -->
        <!-- Note: the original background stroke/color is moved to the design to match the image -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#F1FAEE"
            app:strokeWidth="1dp"
            app:strokeColor="#A5D6A7"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_radio_checked" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_rounded_top"
                    android:backgroundTint="#FFFFFF"
                    android:src="@drawable/ic_database" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvLocal"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Local data"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep the data available on this device"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- REMOTE CARD -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardRemote"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="#FFF0F0"
            app:strokeWidth="1dp"
            app:strokeColor="#EF9A9A"
            app:cardCornerRadius="12dp"
            app:layout_constraintTop_toBottomOf="@id/cardLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="16dp">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_radio_unchecked" />

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginStart="16dp"
                    android:padding="8dp"
                    android:background="@drawable/bg_rounded_top"
                    android:backgroundTint="#FFFFFF"
                    android:src="@drawable/ic_cloud_outline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="16dp">

                    <TextView
                        android:id="@+id/tvRemote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Remote data"
                        android:textColor="#000000"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Use the latest data from the server"
                        android:textColor="#555555"
                        android:textSize="13sp"
                        android:layout_marginTop="2dp" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Info Banner (Visually replaces btnKeepLocal) -->
        <FrameLayout
            android:id="@+id/bannerKeepLocal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/bg_rounded_top"
            android:backgroundTint="#F4F2FA"
            app:layout_constraintTop_toBottomOf="@id/cardRemote"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="16dp"
                android:gravity="top">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@drawable/ic_info_outline" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Keep Local Version"
                        android:textColor="#5E35B1"
                        android:textSize="14sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="Your local data will be preserved and used to resolve this conflict."
                        android:textColor="#424242"
                        android:textSize="13sp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Invisible btnKeepLocal to catch clicks if code dynamically listens to it -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnKeepLocal"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text=""
                app:backgroundTint="@android:color/transparent"
                app:rippleColor="#20000000"
                app:elevation="0dp"
                app:strokeWidth="0dp" />
        </FrameLayout>

        <!-- Accept Button (reusing btnAcceptRemote ID) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnAcceptRemote"
            android:layout_width="0dp"
            android:layout_height="56dp"
            android:layout_marginTop="24dp"
            android:text="Accept Remote Version"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            app:icon="@drawable/ic_sync"
            app:iconGravity="textStart"
            app:iconPadding="8dp"
            app:cornerRadius="12dp"
            app:backgroundTint="#5C6BC0"
            app:layout_constraintTop_toBottomOf="@id/bannerKeepLocal"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
