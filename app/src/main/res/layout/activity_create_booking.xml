<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Booking"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <EditText
            android:id="@+id/etVisitorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Name" />

        <EditText
            android:id="@+id/etVisitorDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Designation" />

        <EditText
            android:id="@+id/etVisitorOrganisation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Organisation" />

        <EditText
            android:id="@+id/etVisitorGender"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Gender" />

        <EditText
            android:id="@+id/etVisitorAddress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Address" />

        <EditText
            android:id="@+id/etVisitorMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Mobile"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etVisitorEmail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Visitor Email"
            android:inputType="textEmailAddress" />



        <EditText
            android:id="@+id/etArrivalDT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Arrival Date &amp; Time"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <EditText
            android:id="@+id/etDepartureDT"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Departure Date &amp; Time"
            android:focusable="false"
            android:clickable="true"
            android:inputType="none"/>

        <EditText
            android:id="@+id/etPurpose"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Purpose of Visit" />

        <EditText
            android:id="@+id/etRequesteeName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requestee Name" />

        <EditText
            android:id="@+id/etRequesteeDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requestee Designation" />

        <EditText
            android:id="@+id/etRequesteeDepartment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requestee Department" />

        <EditText
            android:id="@+id/etRequesteeMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Requestee Mobile"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etLogisticsName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Logistics Name" />

        <EditText
            android:id="@+id/etLogisticsDesignation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Logistics Designation" />

        <EditText
            android:id="@+id/etLogisticsMobile"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Logistics Mobile"
            android:inputType="phone" />

        <EditText
            android:id="@+id/etRoomId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Room ID"
            android:inputType="number" />

        <TextView
            android:id="@+id/tvMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@android:color/holo_red_dark"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

        <Button
            android:id="@+id/btnCreateBooking"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Booking"
            android:layout_marginTop="16dp" />

    </LinearLayout>
</ScrollView>