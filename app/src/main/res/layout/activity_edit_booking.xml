<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/appToolbar"
        android:layout_width="0dp"
        android:layout_height="@dimen/space_56"
        android:background="@color/info_blue"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:menu="@menu/menu_landing_toolbar"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="@color/white" />

    <ImageView
        android:id="@+id/ivBack"
        android:layout_width="@dimen/space_40"
        android:layout_height="@dimen/space_40"
        android:layout_marginTop="@dimen/space_12"
        android:contentDescription="Back"
        android:padding="@dimen/space_12"
        android:src="@drawable/ic_back"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/appToolbar"
        app:tint="@color/white" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Edit Booking"
        android:textColor="@color/white"
        android:textSize="@dimen/text_20"
        android:textStyle="bold"
        app:layout_constraintBottom_toBottomOf="@id/ivBack"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/ivBack" />

    <ScrollView
        android:id="@+id/scrollViewEditBooking"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="@dimen/space_16"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_180"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/ivBack">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/space_16">

            <!-- VISITOR DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visitor Details"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Room No *"
                    android:textColor="@color/edit_section_title"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRoom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingHorizontal="@dimen/space_12" />

                <EditText
                    android:id="@+id/etArrivalAt"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_16"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:focusable="false"
                    android:hint="Check-In Date &amp; Time *"
                    android:inputType="none" />

                <EditText
                    android:id="@+id/etDepartureAt"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:focusable="false"
                    android:hint="Check-Out Date &amp; Time *"
                    android:inputType="none" />

                <EditText
                    android:id="@+id/etVisitorName"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_16"
                    android:drawableStart="@drawable/ic_user"
                    android:hint="Visitor Name *" />

                <EditText
                    android:id="@+id/etVisitorDesignation"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Visitor Designation (Optional)" />

                <EditText
                    android:id="@+id/etVisitorOrganisation"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Visitor Organisation (Optional)" />

                <Spinner
                    android:id="@+id/spinnerGender"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_filter_chip"
                    android:paddingHorizontal="@dimen/space_12" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Guest Nationality (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgVisitorNationality"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_8"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbVisitorIndian"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Indian"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbVisitorForeigner"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Foreigner"
                        android:textColor="@color/detail_text_primary" />

                </RadioGroup>

                <TextView
                    android:id="@+id/btnClearVisitorNationality"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/space_36"
                    android:paddingTop="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6"
                    android:text="Clear Selection"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etVisitorMobile"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ic_phone"
                    android:hint="Visitor Mobile (Optional)"
                    android:inputType="phone"
                    android:maxLength="10" />

                <EditText
                    android:id="@+id/etVisitorEmail"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Visitor Email (Optional)"
                    android:inputType="textEmailAddress" />

                <EditText
                    android:id="@+id/etPurpose"
                    style="@style/EditBookingInput"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ic_documents"
                    android:gravity="top|start"
                    android:hint="Purpose of Visit (Optional)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/etRemarks"
                    style="@style/EditBookingInput"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ic_documents"
                    android:gravity="top|start"
                    android:hint="Remarks (Optional)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="3" />

            </LinearLayout>

            <!-- VISITOR CATEGORY -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Visitor Category (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgVisitorCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical">

                    <RadioButton
                        android:id="@+id/rbInstituteGuest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Institute Guest"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbConferenceGuest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Conference / Workshop Guest"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbOtherGuest"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Other Guest"
                        android:textColor="@color/detail_text_primary" />

                </RadioGroup>

                <TextView
                    android:id="@+id/btnClearVisitorCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/space_36"
                    android:paddingTop="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6"
                    android:text="Clear Selection"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- BUDGET HEAD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Budget Head (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <LinearLayout
                    android:id="@+id/budgetHeadFieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbBudgetHeadName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Individual"
                        android:textColor="@color/detail_text_primary" />

                    <EditText
                        android:id="@+id/etBudgetHeadName"
                        style="@style/EditBookingInput"
                        android:layout_marginTop="@dimen/space_4"
                        android:hint="Name (Optional)"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/cbBudgetHeadDepartmentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:text="Institute Head"
                        android:textColor="@color/detail_text_primary" />

                    <EditText
                        android:id="@+id/etBudgetHeadDepartmentName"
                        style="@style/EditBookingInput"
                        android:layout_marginTop="@dimen/space_4"
                        android:hint="Department Name (Optional)"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/cbBudgetHeadProjectCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:text="Project Head"
                        android:textColor="@color/detail_text_primary" />

                    <EditText
                        android:id="@+id/etBudgetHeadProjectCode"
                        style="@style/EditBookingInput"
                        android:layout_marginTop="@dimen/space_4"
                        android:hint="Project Code (Optional)"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearBudgetHeadFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/space_36"
                    android:paddingTop="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6"
                    android:text="Clear Budget Head"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- REQUESTOR INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Requestor Details (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <EditText
                    android:id="@+id/etRequestorName"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_16"
                    android:hint="Requestor Name (Optional)" />

                <EditText
                    android:id="@+id/etRequestorDesignation"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Requestor Designation (Optional)" />

                <EditText
                    android:id="@+id/etRequestorDepartment"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Requestor Department (Optional)" />

                <EditText
                    android:id="@+id/etRequestorMobile"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Requestor Mobile (Optional)"
                    android:inputType="phone"
                    android:maxLength="10" />

            </LinearLayout>

            <!-- LOGISTICS INFORMATION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Logistics(Food/Cab) will be looked after by (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbLogisticsSameAsRequestor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Same as requestor details"
                    android:textColor="@color/detail_text_primary" />

                <EditText
                    android:id="@+id/etLogisticsName"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_8"
                    android:hint="Logistics Name (Optional)" />

                <EditText
                    android:id="@+id/etLogisticsDesignation"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Logistics Designation (Optional)" />

                <EditText
                    android:id="@+id/etLogisticsMobile"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:hint="Logistics Mobile (Optional)"
                    android:inputType="phone"
                    android:maxLength="10" />

            </LinearLayout>

            <!-- ATTENDER DETAILS -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Attender Details (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbAttenderRequired"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Attender Required (Optional)"
                    android:textColor="@color/detail_text_primary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="(attender charges will be applicable on a per shift basis(8 Hrs) as per govt. applicable rates )"
                    android:textColor="@color/detail_text_secondary"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvSelectShiftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:alpha="0.45"
                    android:text="Select Shift(s) * (if attender required)"
                    android:textColor="@color/edit_section_title"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbMorningShift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:text="Morning Shift (7 AM - 3 PM)"
                    android:textColor="@color/detail_text_primary" />

                <CheckBox
                    android:id="@+id/cbEveningShift"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:text="Evening Shift (3 PM - 11 PM)"
                    android:textColor="@color/detail_text_primary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Attender Charges Received (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgAttenderChargesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAttenderChargesYes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbAttenderChargesNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="No"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbAttenderChargesWaived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waived Off"
                        android:textColor="@color/detail_text_primary" />

                </RadioGroup>

                <EditText
                    android:id="@+id/etAttenderChargesAmount"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:enabled="false"
                    android:hint="Attender Charges Amount * (if Yes)"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <!-- ROOM CHARGES -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_18">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room Charges (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textSize="@dimen/text_17"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_16"
                    android:text="Room Charges Received (Optional)"
                    android:textColor="@color/edit_section_title"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgRoomChargesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbRoomChargesYes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbRoomChargesNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="No"
                        android:textColor="@color/detail_text_primary" />

                    <RadioButton
                        android:id="@+id/rbRoomChargesWaived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waived Off"
                        android:textColor="@color/detail_text_primary" />

                </RadioGroup>

                <EditText
                    android:id="@+id/etRoomChargesAmount"
                    style="@style/EditBookingInput"
                    android:layout_marginTop="@dimen/space_12"
                    android:enabled="false"
                    android:hint="Room Charges Amount * (if Yes)"
                    android:inputType="numberDecimal" />

            </LinearLayout>

            <!-- MESSAGE -->
            <TextView
                android:id="@+id/tvMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:padding="@dimen/space_14"
                android:textColor="@color/error_red"
                android:textSize="@dimen/text_14"
                android:visibility="gone" />

            <!-- SAVE BUTTON -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:background="@drawable/bg_detail_card"
                android:orientation="vertical"
                android:padding="@dimen/space_16">

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSaveBooking"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:background="@drawable/bg_button_gradient"
                    android:text="Save Booking"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_16"
                    android:textStyle="bold" />

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_180" />

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
