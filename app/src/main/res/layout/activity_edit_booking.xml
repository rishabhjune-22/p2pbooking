<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F6FA">

    <!-- 🔵 TOP GRADIENT -->
    <View
        android:layout_width="match_parent"
        android:layout_height="220dp"
        android:background="@drawable/bg_top_rounded"/>

    <!-- CONTENT -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- TITLE -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Edit Booking"
                android:layout_gravity="center"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:layout_marginTop="50dp"
                android:layout_marginBottom="20dp"/>

            <!-- CARD -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:cardBackgroundColor="#FFFFFF"
                xmlns:app="http://schemas.android.com/apk/res-auto">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Visitor Name -->
                    <EditText
                        android:id="@+id/etVisitorName"
                        style="@style/EditTextStyle"
                        android:hint="Visitor Name"
                        android:drawableStart="@drawable/user_02"/>

                    <!-- Mobile -->
                    <EditText
                        android:id="@+id/etVisitorMobile"
                        style="@style/EditTextStyle"
                        android:hint="Visitor Mobile"
                        android:inputType="phone"
                        android:drawableStart="@drawable/phone_svgrepo_com"/>

                    <!-- Purpose -->
                    <EditText
                        android:id="@+id/etPurpose"
                        style="@style/EditTextStyle"
                        android:hint="Purpose of Visit"
                        android:drawableStart="@drawable/documents_svgrepo_com"/>

                    <!-- Arrival -->
                    <EditText
                        android:id="@+id/etArrivalAt"
                        style="@style/EditTextStyle"
                        android:hint="Arrival Date/Time"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableStart="@drawable/calender_svgrepo_com"/>

                    <!-- Departure -->
                    <EditText
                        android:id="@+id/etDepartureAt"
                        style="@style/EditTextStyle"
                        android:hint="Departure Date/Time"
                        android:focusable="false"
                        android:clickable="true"
                        android:drawableStart="@drawable/calender_svgrepo_com"/>

                    <!-- BUTTON -->
                    <androidx.appcompat.widget.AppCompatButton
                        android:id="@+id/btnSaveBooking"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Save Booking"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:layout_marginTop="20dp"
                        android:background="@drawable/bg_button"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>