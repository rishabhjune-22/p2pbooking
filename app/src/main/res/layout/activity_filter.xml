<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clickable="true"
    android:fitsSystemWindows="true"
    android:focusableInTouchMode="true"
    android:background="@android:color/transparent">

    <View
        android:id="@+id/filterScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#6623386D" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="bottom"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/filterSheet"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clickable="true"
            android:background="@drawable/bg_filter_sheet"
            android:elevation="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginTop="60dp"
            android:orientation="vertical"
            android:paddingStart="20dp"
            android:paddingTop="12dp"
            android:paddingEnd="20dp"
            android:paddingBottom="20dp">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="18dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="28dp"
                        android:layout_height="28dp"
                        android:src="@drawable/filter_svgrepo_com"
                        app:tint="#635BFF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="14dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="@string/filter_title"
                        android:textColor="#1D2640"
                        android:textSize="22sp" />
                </LinearLayout>

                <ImageView
                    android:id="@+id/ivClose"
                    android:layout_width="28dp"
                    android:layout_height="28dp"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:contentDescription="@string/filter_close"
                    android:padding="2dp"
                    android:src="@android:drawable/ic_menu_close_clear_cancel"
                    app:tint="#6C748E" />
            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="16dp"
                android:background="#EEF1F8" />

            <ScrollView
                android:id="@+id/filterScrollView"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_marginTop="14dp"
                android:layout_weight="1"
                android:fillViewport="true"
                android:fadingEdge="none"
                android:overScrollMode="never"
                android:scrollbars="none">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_filter_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_filter_icon_purple">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/user_svgrepo_com"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/filter_visitor_details"
                                android:textColor="#635BFF"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etVisitorName"
                            style="@style/FilterFieldEditText"
                            android:layout_marginTop="16dp"
                            android:drawableStart="@drawable/user_svgrepo_com"
                            android:hint="@string/filter_visitor_name"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/etOrganisation"
                            style="@style/FilterFieldEditText"
                            android:drawableStart="@drawable/organisation_svgrepo_com"
                            android:hint="@string/filter_organisation"
                            android:inputType="textCapWords" />

                        <TextView
                            android:id="@+id/tvGender"
                            style="@style/FilterFieldLabel"
                            android:drawableStart="@drawable/identification_card_thin_svgrepo_com"
                            android:text="@string/filter_select_gender" />

                        <EditText
                            android:id="@+id/etMobile"
                            style="@style/FilterFieldEditText"
                            android:drawableStart="@drawable/phone_svgrepo_com"
                            android:hint="@string/filter_mobile_number"
                            android:inputType="phone" />

                        <EditText
                            android:id="@+id/etEmail"
                            style="@style/FilterFieldEditText"
                            android:drawableStart="@drawable/mail_02"
                            android:hint="@string/filter_email_address"
                            android:inputType="textEmailAddress" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_filter_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_filter_icon_blue">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/calender_svgrepo_com"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/filter_visit_details"
                                android:textColor="#4D7CFE"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvArrivalFrom"
                            style="@style/FilterFieldLabel"
                            android:layout_marginTop="16dp"
                            android:drawableStart="@drawable/calender_svgrepo_com"
                            android:text="@string/filter_arrival_from" />

                        <TextView
                            android:id="@+id/tvArrivalTo"
                            style="@style/FilterFieldLabel"
                            android:drawableStart="@drawable/calender_svgrepo_com"
                            android:text="@string/filter_arrival_to" />

                        <TextView
                            android:id="@+id/tvDepartureFrom"
                            style="@style/FilterFieldLabel"
                            android:drawableStart="@drawable/calender_svgrepo_com"
                            android:text="@string/filter_departure_from" />

                        <TextView
                            android:id="@+id/tvDepartureTo"
                            style="@style/FilterFieldLabel"
                            android:drawableStart="@drawable/calender_svgrepo_com"
                            android:text="@string/filter_departure_to" />

                        <TextView
                            android:id="@+id/tvPurpose"
                            style="@style/FilterFieldLabel"
                            android:drawableStart="@drawable/create_note_svgrepo_com"
                            android:text="@string/filter_select_purpose" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_filter_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_filter_icon_green">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/user_profile_svgrepo_com"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/filter_requestee_details"
                                android:textColor="#2FB36C"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <EditText
                            android:id="@+id/etRequesteeName"
                            style="@style/FilterFieldEditText"
                            android:layout_marginTop="16dp"
                            android:drawableStart="@drawable/user_svgrepo_com"
                            android:hint="@string/filter_requestee_name"
                            android:inputType="textPersonName" />

                        <EditText
                            android:id="@+id/etDepartment"
                            style="@style/FilterFieldEditText"
                            android:drawableStart="@drawable/default_department_svgrepo_com"
                            android:hint="@string/filter_department"
                            android:inputType="textCapWords" />

                        <EditText
                            android:id="@+id/etRequesteeMobile"
                            style="@style/FilterFieldEditText"
                            android:drawableStart="@drawable/phone_svgrepo_com"
                            android:hint="@string/filter_requestee_mobile"
                            android:inputType="phone" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_filter_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_filter_icon_orange">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/hostel_svgrepo_com"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/filter_room_details"
                                android:textColor="#FF8B2B"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvRoom"
                            style="@style/FilterFieldLabel"
                            android:layout_marginTop="16dp"
                            android:drawableStart="@drawable/hostel_svgrepo_com"
                            android:text="@string/filter_select_room" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:background="@drawable/bg_filter_section"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_filter_icon_indigo">

                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/documents_svgrepo_com"
                                    app:tint="@android:color/white" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="12dp"
                                android:fontFamily="sans-serif-medium"
                                android:text="@string/filter_booking_status"
                                android:textColor="#4D7CFE"
                                android:textSize="17sp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvStatus"
                            style="@style/FilterFieldLabel"
                            android:layout_marginTop="16dp"
                            android:drawableStart="@drawable/documents_svgrepo_com"
                            android:text="@string/filter_select_status" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnReset"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginEnd="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_filter_outline_button"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/filter_reset"
                            android:textColor="#635BFF"
                            android:textSize="18sp" />

                        <TextView
                            android:id="@+id/btnApply"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_filter_primary_button"
                            android:fontFamily="sans-serif-medium"
                            android:gravity="center"
                            android:text="@string/filter_apply"
                            android:textColor="@android:color/white"
                            android:textSize="18sp" />
                    </LinearLayout>
                </LinearLayout>
            </ScrollView>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
