<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_10"
    app:cardBackgroundColor="@color/booking_card_bg"
    app:cardCornerRadius="20dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/root"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/space_16">

        <View
            android:id="@+id/viewAccent"
            android:layout_width="@dimen/space_4"
            android:layout_height="0dp"
            android:background="@drawable/bg_booking_accent_bar"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="@dimen/space_44"
            android:layout_height="@dimen/space_44"
            android:layout_marginStart="@dimen/space_14"
            android:background="@drawable/bg_status_active_soft"
            android:padding="@dimen/space_8"
            android:src="@drawable/mens_room"
            app:layout_constraintStart_toEndOf="@id/viewAccent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tvStatus"
            style="@style/BookingStatusChipDimensions"
            android:gravity="center"
            android:singleLine="true"
            android:ellipsize="none"
            android:text="Cancelled"
            android:textColor="@color/status_cancelled"
            android:textSize="@dimen/text_12"
            android:textStyle="bold"
            android:background="@drawable/bg_status_cancelled"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/ivAvatar" />

        <TextView
            android:id="@+id/tvVisitorName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Visitor Name"
            android:textColor="@color/palette_30303a"
            android:textSize="@dimen/text_17"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvStatus"
            app:layout_constraintStart_toEndOf="@id/ivAvatar"
            app:layout_constraintTop_toTopOf="@id/ivAvatar" />

        <!-- Room -->
        <LinearLayout
            android:id="@+id/cellRoom"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/space_22"
                android:layout_height="@dimen/space_22"
                android:src="@drawable/bed_svgrepo_com"
                app:tint="@color/icon_tint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Room"
                    android:textColor="@color/palette_9c9caa"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvRoomName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Delta 101"
                    android:textColor="@color/palette_3d3d47"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Organisation -->
        <LinearLayout
            android:id="@+id/cellOrganisation"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/space_22"
                android:layout_height="@dimen/space_22"
                android:src="@android:drawable/ic_menu_myplaces"
                app:tint="@color/icon_tint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Organisation"
                    android:textColor="@color/palette_9c9caa"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvOrganisation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="****"
                    android:textColor="@color/palette_3d3d47"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Arrival -->
        <LinearLayout
            android:id="@+id/cellArrival"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/space_22"
                android:layout_height="@dimen/space_22"
                android:src="@drawable/calender_svgrepo_com"
                app:tint="@color/icon_tint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Arrival"
                    android:textColor="@color/palette_9c9caa"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvArrival"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="2026-05-13"
                    android:textColor="@color/palette_3d3d47"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Departure -->
        <LinearLayout
            android:id="@+id/cellDeparture"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/space_22"
                android:layout_height="@dimen/space_22"
                android:src="@drawable/calender_svgrepo_com"
                app:tint="@color/icon_tint" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_8"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Departure"
                    android:textColor="@color/palette_9c9caa"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvDeparture"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="2"
                    android:text="2026-05-13"
                    android:textColor="@color/palette_3d3d47"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Grid: only 4 items -->
        <androidx.constraintlayout.helper.widget.Flow
            android:id="@+id/flowGrid"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            app:constraint_referenced_ids="cellRoom,cellOrganisation,cellArrival,cellDeparture"
            app:flow_horizontalGap="20dp"
            app:flow_maxElementsWrap="2"
            app:flow_verticalGap="16dp"
            app:flow_wrapMode="aligned"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/ivAvatar" />

        <!-- Purpose full-width row -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cellPurpose"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="@id/ivAvatar"
            app:layout_constraintTop_toBottomOf="@id/flowGrid">

            <ImageView
                android:id="@+id/ivPurposeIcon"
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@android:drawable/ic_menu_info_details"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:tint="@color/icon_tint" />

                <TextView
                    android:id="@+id/tvPurposeLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="Purpose"
                    android:textColor="@color/palette_9c9caa"
                    android:textSize="@dimen/text_12"
                    app:layout_constraintStart_toEndOf="@id/ivPurposeIcon"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    android:id="@+id/tvRequestedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="By: nehas"
                    android:textColor="@color/palette_8f8f99"
                    android:textSize="@dimen/text_12"
                    android:textStyle="italic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toTopOf="@id/tvPurposeLabel" />
                <TextView
                    android:id="@+id/tvCreatedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Created By: Admin"
                    android:textColor="@color/palette_8f8f99"
                    android:textSize="@dimen/text_12"
                    android:textStyle="italic"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tvRequestedBy" />
                <TextView
                    android:id="@+id/tvPurpose"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="Project Discussion"
                    android:textColor="@color/palette_3d3d47"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="@id/tvPurposeLabel"
                    app:layout_constraintTop_toBottomOf="@id/tvPurposeLabel" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- This bottom constraint prevents overlap/cutoff -->
        <Space
            android:id="@+id/bottomSpace"
            android:layout_width="@dimen/space_1"
            android:layout_height="@dimen/space_1"
            app:layout_constraintTop_toBottomOf="@id/cellPurpose"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
