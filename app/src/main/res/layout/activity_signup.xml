<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:minHeight="720dp"
        android:orientation="vertical"
        android:padding="@dimen/space_24">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_create_booking_card"
            android:elevation="@dimen/space_8"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/space_24">

            <ImageView
                android:layout_width="@dimen/space_76"
                android:layout_height="@dimen/space_76"
                android:contentDescription="@string/iit_bhilai_logo"
                android:scaleType="fitCenter"
                android:src="@drawable/logo_iit_bhilai" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:gravity="center"
                android:text="@string/signup_title"
                android:textColor="@color/detail_text_primary"
                android:textSize="@dimen/text_22"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_4"
                android:gravity="center"
                android:text="@string/signup_subtitle"
                android:textColor="@color/detail_text_secondary"
                android:textSize="@dimen/text_14" />

            <EditText
                android:id="@+id/etName"
                style="@style/CreateBookingEditText"
                android:layout_marginTop="@dimen/space_24"
                android:autofillHints="name"
                android:drawableStart="@drawable/ic_user"
                android:hint="@string/full_name"
                android:inputType="textPersonName|textCapWords"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etEmail"
                style="@style/CreateBookingEditText"
                android:layout_marginTop="@dimen/space_12"
                android:autofillHints="emailAddress"
                android:drawableStart="@drawable/ic_email"
                android:hint="@string/email"
                android:inputType="textEmailAddress"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etPassword"
                style="@style/CreateBookingEditText"
                android:layout_marginTop="@dimen/space_12"
                android:autofillHints="newPassword"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:hint="@string/password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <EditText
                android:id="@+id/etConfirmPassword"
                style="@style/CreateBookingEditText"
                android:layout_marginTop="@dimen/space_12"
                android:autofillHints="newPassword"
                android:drawableStart="@android:drawable/ic_lock_lock"
                android:hint="@string/confirm_password"
                android:inputType="textPassword"
                android:singleLine="true" />

            <TextView
                android:id="@+id/tvError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_12"
                android:background="@drawable/bg_create_booking_info"
                android:padding="@dimen/space_12"
                android:textColor="@color/create_booking_error"
                android:textSize="@dimen/text_13"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_16"
                android:visibility="gone" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnSignup"
                android:layout_width="match_parent"
                android:layout_height="@dimen/space_52"
                android:layout_marginTop="@dimen/space_18"
                android:background="@drawable/bg_create_booking_primary_button"
                android:text="@string/action_create_account"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvLogin"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/space_18"
                android:padding="@dimen/space_8"
                android:text="@string/action_open_login"
                android:textColor="@color/info_blue"
                android:textSize="@dimen/text_14"
                android:textStyle="bold" />

        </LinearLayout>

    </LinearLayout>

</ScrollView>
