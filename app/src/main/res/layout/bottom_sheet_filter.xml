<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/filterRootScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_filter_bottom_sheet"
    android:overScrollMode="never">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_16">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_filter_header"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/space_16">

            <ImageView
                android:layout_width="@dimen/space_44"
                android:layout_height="@dimen/space_44"
                android:background="@drawable/bg_filter_header_icon"
                android:contentDescription="Filter"
                android:padding="@dimen/space_10"
                android:src="@drawable/ic_filter"
                app:tint="@color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_12"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Filter bookings"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_20"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="Narrow results by building and dates"
                    android:textColor="#D9D7FF"
                    android:textSize="@dimen/text_12" />
            </LinearLayout>

            <ImageButton
                android:id="@+id/btnCloseFilter"
                android:layout_width="@dimen/space_40"
                android:layout_height="@dimen/space_40"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="Close filters"
                android:padding="@dimen/space_10"
                android:src="@drawable/ic_close"
                app:tint="@color/white" />
        </LinearLayout>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_14"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/space_16"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="BUILDING"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_11"
                    android:textStyle="bold" />

                <AutoCompleteTextView
                    android:id="@+id/actBuilding"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginTop="@dimen/space_8"
                    android:background="@drawable/bg_filter_input"
                    android:clickable="true"
                    android:drawableEnd="@drawable/ic_arrow_drop_down"
                    android:focusable="false"
                    android:hint="All buildings"
                    android:inputType="none"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14"
                    android:singleLine="true"
                    android:textColor="@color/text_primary"
                    android:textColorHint="@color/text_hint"
                    android:textSize="@dimen/text_15" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_12"
            app:cardBackgroundColor="@color/white"
            app:cardCornerRadius="@dimen/space_16"
            app:cardElevation="0dp"
            app:strokeColor="@color/border_light"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/space_14">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="DATE RANGE"
                    android:textColor="@color/primary"
                    android:textSize="@dimen/text_11"
                    android:textStyle="bold" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:orientation="horizontal">

                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnCustomRange" style="@style/FilterQuickRangeButton" android:text="Custom" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnThreeMonths" style="@style/FilterQuickRangeButton" android:layout_marginStart="@dimen/space_8" android:text="3 months" />
                    <androidx.appcompat.widget.AppCompatButton android:id="@+id/btnSixMonths" style="@style/FilterQuickRangeButton" android:layout_marginStart="@dimen/space_8" android:text="6 months" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvSelectedDateRange"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_filter_input"
                    android:drawableEnd="@drawable/ic_calendar_field"
                    android:gravity="center_vertical"
                    android:paddingStart="@dimen/space_14"
                    android:paddingEnd="@dimen/space_14"
                    android:text="Select date range"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_14" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_16"
            android:orientation="horizontal">

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnResetFilters"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_52"
                android:layout_marginEnd="@dimen/space_6"
                android:layout_weight="1"
                android:background="@drawable/bg_filter_reset_button"
                android:backgroundTint="@null"
                android:text="Reset"
                android:textAllCaps="false"
                android:textColor="@color/primary"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnApplyFilter"
                android:layout_width="0dp"
                android:layout_height="@dimen/space_52"
                android:layout_marginStart="@dimen/space_6"
                android:layout_weight="2"
                android:background="@drawable/bg_filter_apply_button"
                android:backgroundTint="@null"
                android:text="Show results"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textSize="@dimen/text_15"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
