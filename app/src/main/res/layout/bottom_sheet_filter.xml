<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/filterRootScroll"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false"
    android:background="@drawable/bg_filter_bottom_sheet">

    <LinearLayout
        android:id="@+id/filterRoot"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_22"
        android:paddingTop="@dimen/space_18"
        android:paddingEnd="@dimen/space_22"
        android:paddingBottom="@dimen/space_24">

        <View
            android:layout_width="@dimen/space_42"
            android:layout_height="@dimen/space_4"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="@dimen/space_18"
            android:background="@drawable/bg_bottom_sheet_handle" />

        <TextView
            android:id="@+id/tvFilterTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Filter Bookings"
            android:textColor="@color/black"
            android:textSize="@dimen/text_21"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvFilterSubtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:layout_marginBottom="@dimen/space_20"
            android:text="Choose building and date range"
            android:textColor="#6B7280"
            android:textSize="@dimen/text_13" />

        <TextView
            android:id="@+id/tvBuildingLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/space_7"
            android:text="Building Type"
            android:textColor="#374151"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <AutoCompleteTextView
            android:id="@+id/actBuilding"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:background="@drawable/bg_filter_input"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_arrow_drop_down"
            android:focusable="false"
            android:hint="Select building"
            android:inputType="none"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textColorHint="#9CA3AF"
            android:textSize="@dimen/text_15" />

        <TextView
            android:id="@+id/tvQuickRangeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_18"
            android:layout_marginBottom="@dimen/space_9"
            android:text="Quick Date Range"
            android:textColor="#374151"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <LinearLayout
            android:id="@+id/layoutQuickRange"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="3">

            <Button
                android:id="@+id/btnCustomRange"
                style="@style/FilterQuickRangeButton"
                android:text="Custom" />

            <Button
                android:id="@+id/btnThreeMonths"
                style="@style/FilterQuickRangeButton"
                android:layout_marginStart="8dp"
                android:text="3 Months" />

            <Button
                android:id="@+id/btnSixMonths"
                style="@style/FilterQuickRangeButton"
                android:layout_marginStart="8dp"
                android:text="6 Months" />

        </LinearLayout>


        <TextView
            android:id="@+id/tvDateRangeLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:layout_marginBottom="7dp"
            android:text="Selected Date Range"
            android:textColor="#374151"
            android:textSize="@dimen/text_14"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSelectedDateRange"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_52"
            android:background="@drawable/bg_filter_input"
            android:drawableEnd="@drawable/ic_calendar_field"
            android:gravity="center_vertical"
            android:paddingStart="@dimen/space_14"
            android:paddingEnd="@dimen/space_14"
            android:text="Select date range"
            android:textColor="#111827"
            android:textSize="@dimen/text_15" />

        <Button
            android:id="@+id/btnApplyFilter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/space_54"
            android:layout_marginTop="@dimen/space_24"
            android:background="@drawable/bg_filter_apply_button"
            android:text="Apply Filter"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="@dimen/text_16"
            android:textStyle="bold" />

    </LinearLayout>

</ScrollView>
