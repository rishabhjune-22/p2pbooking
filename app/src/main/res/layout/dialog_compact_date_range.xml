<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_16"
    android:paddingTop="@dimen/space_12"
    android:paddingEnd="@dimen/space_16"
    android:paddingBottom="@dimen/space_8">

    <TextView
        android:id="@+id/tvRangeSelection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_filter_input"
        android:gravity="center"
        android:minHeight="@dimen/space_48"
        android:padding="@dimen/space_8"
        android:text="Tap an arrival date"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/text_14"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_48"
        android:layout_marginTop="@dimen/space_8"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/btnPreviousCalendarMonth"
            android:layout_width="@dimen/space_44"
            android:layout_height="@dimen/space_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Previous month"
            android:padding="@dimen/space_12"
            android:rotation="180"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/primary" />

        <TextView
            android:id="@+id/tvCalendarMonth"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_17"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/btnNextCalendarMonth"
            android:layout_width="@dimen/space_44"
            android:layout_height="@dimen/space_44"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Next month"
            android:padding="@dimen/space_12"
            android:src="@drawable/ic_arrow_right"
            app:tint="@color/primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_30"
        android:orientation="horizontal">

        <TextView style="@style/CompactCalendarWeekday" android:text="S" />
        <TextView style="@style/CompactCalendarWeekday" android:text="M" />
        <TextView style="@style/CompactCalendarWeekday" android:text="T" />
        <TextView style="@style/CompactCalendarWeekday" android:text="W" />
        <TextView style="@style/CompactCalendarWeekday" android:text="T" />
        <TextView style="@style/CompactCalendarWeekday" android:text="F" />
        <TextView style="@style/CompactCalendarWeekday" android:text="S" />
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvCompactCalendar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_260"
        android:overScrollMode="never" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:text="Tap arrival, then departure"
        android:textColor="@color/text_secondary"
        android:textSize="@dimen/text_12" />

</LinearLayout>
