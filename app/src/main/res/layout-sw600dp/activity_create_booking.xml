<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootView"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/create_booking_bg">

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/space_260"
        android:layout_marginTop="@dimen/space_60"
        android:background="@drawable/bg_create_booking_header" />

    <ScrollView
        android:id="@+id/scrollCreateBooking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false"
        android:fillViewport="true"
        android:layout_marginTop="@dimen/space_60"
        android:overScrollMode="never"
        android:paddingBottom="@dimen/space_24"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/space_32"
            android:orientation="vertical">

            <!-- HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/space_12"
                android:paddingTop="@dimen/space_18"
                android:paddingEnd="@dimen/space_12">

                <ImageButton
                    android:id="@+id/btnBack"
                    android:layout_width="@dimen/space_50"
                    android:layout_height="@dimen/space_50"
                    android:background="@android:color/transparent"
                    android:contentDescription="Back"
                    android:padding="@dimen/space_8"
                    android:src="@drawable/ic_back"
                    app:tint="@color/white" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="@dimen/space_40">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_40"
                        android:gravity="center"
                        android:text="Create Booking"
                        android:textColor="@color/white"
                        android:textSize="@dimen/text_28"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_8"
                        android:gravity="center"
                        android:text="Fill the details to create a new booking"
                        android:textColor="@color/create_booking_header_subtitle"
                        android:textSize="@dimen/text_14" />

                </LinearLayout>

            </LinearLayout>

            <!-- CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/space_32"
                android:layout_marginTop="@dimen/space_18"
                android:layout_marginEnd="@dimen/space_32"
                android:background="@drawable/bg_create_booking_card"
                android:elevation="@dimen/space_8"
                android:orientation="vertical"
                android:padding="@dimen/space_28">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingEnd="@dimen/space_12">

                <!-- ROOM DETAILS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_room"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_hostel"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Visitor Details"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_room" />

                <CheckBox
                    android:id="@+id/cbFillFromPreviousBooking"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Fill from previous booking"
                    android:textColor="@color/create_booking_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Room No *"
                    android:textColor="@color/create_booking_label"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerRoom"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_create_booking_spinner"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:spinnerMode="dropdown" />
                <TextView
                    android:id="@+id/tvPartialRoomInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_create_booking_info"
                    android:drawableStart="@android:drawable/ic_dialog_info"
                    android:drawablePadding="@dimen/space_8"
                    android:padding="@dimen/space_12"
                    android:textColor="@color/create_booking_text_secondary"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold"
                    android:drawableTint="@color/availability_partially"
                    android:visibility="gone" />
                <EditText
                    android:id="@+id/etArrivalDT"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_12"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:focusable="false"
                    android:hint="Check-In Date &amp; Time *"
                    android:inputType="none" />

                <EditText
                    android:id="@+id/etDepartureDT"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:clickable="true"
                    android:drawableStart="@drawable/ic_calendar"
                    android:focusable="false"
                    android:hint="Check-Out Date &amp; Time *"
                    android:inputType="none" />

                <EditText
                    android:id="@+id/etVisitorName"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ic_user"
                    android:hint="Visitor Name *" />

                <EditText
                    android:id="@+id/etVisitorDesignation"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_identification"
                    android:hint="Designation (Optional)" />

                <EditText
                    android:id="@+id/etVisitorOrganisation"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_organization"
                    android:hint="Organisation (Optional)" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Gender (Optional)"
                    android:textColor="@color/create_booking_label"
                    android:textSize="@dimen/text_12"
                    android:textStyle="bold" />

                <Spinner
                    android:id="@+id/spinnerGender"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_6"
                    android:background="@drawable/bg_create_booking_spinner"
                    android:paddingStart="@dimen/space_12"
                    android:paddingEnd="@dimen/space_12"
                    android:spinnerMode="dropdown" />

                <EditText
                    android:id="@+id/etVisitorMobile"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_phone"
                    android:hint="Mobile Number (Optional)"
                    android:inputType="phone" />

                <EditText
                    android:id="@+id/etVisitorEmail"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_email"
                    android:hint="Email Address (Optional)"
                    android:inputType="textEmailAddress" />

                <!-- PURPOSE OF VISIT -->
                <EditText
                    android:id="@+id/etPurpose"
                    style="@style/CreateBookingEditText"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:drawableStart="@drawable/ic_documents"
                    android:gravity="top|start"
                    android:hint="Purpose of Visit (Optional)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="3" />

                <EditText
                    android:id="@+id/etRemarks"
                    style="@style/CreateBookingEditText"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_documents"
                    android:gravity="top|start"
                    android:hint="Remarks (Optional)"
                    android:inputType="textMultiLine|textCapSentences"
                    android:maxLines="5"
                    android:minLines="3" />

                <!-- VISITOR CATEGORY -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_visit"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_user"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Visitor Category (Optional)"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_visit" />

                <RadioGroup
                    android:id="@+id/rgVisitorCategory"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:textColor="@color/create_booking_text_secondary">

                    <RadioButton
                        android:id="@+id/rbInstituteGuest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Institute Guest (Official Institute Guest)"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbConferenceGuest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Conference / Workshop Guest"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbOtherGuest"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Other Guest"
                        android:textColor="@color/create_booking_text_secondary" />

                </RadioGroup>

                <TextView
                    android:id="@+id/btnClearVisitorCategory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/space_36"
                    android:paddingTop="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6"
                    android:text="Clear Selection"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="@dimen/space_12">

                <!-- BUDGET HEAD -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_requestor"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_documents"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Budget Head (Optional)"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_requestor" />

                <LinearLayout
                    android:id="@+id/budgetHeadFieldsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:orientation="vertical">

                    <CheckBox
                        android:id="@+id/cbBudgetHeadName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Individual"
                        android:textColor="@color/create_booking_text_secondary" />

                    <EditText
                        android:id="@+id/etBudgetHeadName"
                        style="@style/CreateBookingEditText"
                        android:layout_marginTop="@dimen/space_4"
                        android:drawableStart="@drawable/ic_documents"
                        android:hint="Name (Optional)"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/cbBudgetHeadDepartmentName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:text="Institute Head"
                        android:textColor="@color/create_booking_text_secondary" />

                    <EditText
                        android:id="@+id/etBudgetHeadDepartmentName"
                        style="@style/CreateBookingEditText"
                        android:layout_marginTop="@dimen/space_4"
                        android:drawableStart="@drawable/ic_department"
                        android:hint="Department Name (Optional)"
                        android:visibility="gone" />

                    <CheckBox
                        android:id="@+id/cbBudgetHeadProjectCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_10"
                        android:text="Project Head"
                        android:textColor="@color/create_booking_text_secondary" />

                    <EditText
                        android:id="@+id/etBudgetHeadProjectCode"
                        style="@style/CreateBookingEditText"
                        android:layout_marginTop="@dimen/space_4"
                        android:drawableStart="@drawable/ic_documents"
                        android:hint="Project Code (Optional)"
                        android:visibility="gone" />

                </LinearLayout>

                <TextView
                    android:id="@+id/btnClearBudgetHeadFocus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_4"
                    android:clickable="true"
                    android:focusable="true"
                    android:minHeight="@dimen/space_36"
                    android:paddingTop="@dimen/space_6"
                    android:paddingBottom="@dimen/space_6"
                    android:text="Clear Budget Head"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_13"
                    android:textStyle="bold" />

                <!-- REQUESTOR DETAILS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_requestor"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_user"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Requestor Details (Optional)"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_requestor" />

                <EditText
                    android:id="@+id/etRequestorName"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_12"
                    android:drawableStart="@drawable/ic_user"
                    android:hint="Requestor Name (Optional)" />

                <EditText
                    android:id="@+id/etRequestorDesignation"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_identification"
                    android:hint="Designation (Optional)" />

                <EditText
                    android:id="@+id/etRequestorDepartment"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_department"
                    android:hint="Department (Optional)" />

                <EditText
                    android:id="@+id/etRequestorMobile"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_phone"
                    android:hint="Mobile Number (Optional)"
                    android:inputType="phone" />

                <!-- LOGISTICS DETAILS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_logistics"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_documents"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Logistics(Food/Cab) will be looked after by (Optional)"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_logistics" />

                <CheckBox
                    android:id="@+id/cbLogisticsSameAsRequestor"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Same as requestor details"
                    android:textColor="@color/create_booking_text_secondary" />

                <EditText
                    android:id="@+id/etLogisticsName"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_8"
                    android:drawableStart="@drawable/ic_user"
                    android:hint="Logistics Name (Optional)" />

                <EditText
                    android:id="@+id/etLogisticsDesignation"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_identification"
                    android:hint="Designation (Optional)" />

                <EditText
                    android:id="@+id/etLogisticsMobile"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:drawableStart="@drawable/ic_phone"
                    android:hint="Mobile Number (Optional)"
                    android:inputType="phone" />

                <!-- ATTENDER DETAILS -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_30"
                        android:background="@drawable/bg_section_icon_logistics"
                        android:padding="@dimen/space_5"
                        android:src="@drawable/ic_user"
                        app:tint="@color/white" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/space_8"
                        android:text="Attender Requirement (Optional)"
                        android:textColor="@color/create_booking_text_secondary"
                        android:textSize="@dimen/text_15"
                        android:textStyle="bold" />

                </LinearLayout>

                <View
                    android:layout_width="@dimen/space_30"
                    android:layout_height="@dimen/space_3"
                    android:layout_marginStart="@dimen/space_34"
                    android:layout_marginTop="@dimen/space_4"
                    android:background="@color/section_logistics" />

                <CheckBox
                    android:id="@+id/cbAttenderRequired"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Attender Required (Optional)"
                    android:textColor="@color/create_booking_text_secondary" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_2"
                    android:text="(attender charges will be applicable on a per shift basis(8 Hrs) as per govt. applicable rates )"
                    android:textColor="@color/create_booking_label"
                    android:textSize="@dimen/text_12" />

                <TextView
                    android:id="@+id/tvSelectShiftLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:alpha="0.45"
                    android:text="Select Shift(s) * (if attender required)"
                    android:textColor="@color/create_booking_label"
                    android:textStyle="bold" />

                <CheckBox
                    android:id="@+id/cbMorningShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:text="Morning Shift (7 AM - 3 PM)"
                    android:textColor="@color/create_booking_text_secondary" />

                <CheckBox
                    android:id="@+id/cbEveningShift"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:alpha="0.45"
                    android:enabled="false"
                    android:text="Evening Shift (3 PM - 11 PM)"
                    android:textColor="@color/create_booking_text_secondary" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Attender Charges Received (Optional)"
                    android:textColor="@color/create_booking_label"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgAttenderChargesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbAttenderChargesYes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbAttenderChargesNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="No"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbAttenderChargesWaived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waived Off"
                        android:textColor="@color/create_booking_text_secondary" />

                </RadioGroup>

                <EditText
                    android:id="@+id/etAttenderChargesAmount"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:enabled="false"
                    android:hint="Attender Charges Amount * (if Yes)"
                    android:inputType="numberDecimal" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:text="Room Charges Received (Optional)"
                    android:textColor="@color/create_booking_label"
                    android:textStyle="bold" />

                <RadioGroup
                    android:id="@+id/rgRoomChargesStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/rbRoomChargesYes"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Yes"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbRoomChargesNo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="No"
                        android:textColor="@color/create_booking_text_secondary" />

                    <RadioButton
                        android:id="@+id/rbRoomChargesWaived"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Waived Off"
                        android:textColor="@color/create_booking_text_secondary" />

                </RadioGroup>

                <EditText
                    android:id="@+id/etRoomChargesAmount"
                    style="@style/CreateBookingEditText"
                    android:layout_marginTop="@dimen/space_10"
                    android:enabled="false"
                    android:hint="Room Charges Amount * (if Yes)"
                    android:inputType="numberDecimal" />

                    </LinearLayout>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/reviewRemarksContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_18"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageView
                            android:layout_width="@dimen/space_30"
                            android:layout_height="@dimen/space_30"
                            android:background="@drawable/bg_section_icon_requestor"
                            android:padding="@dimen/space_5"
                            android:src="@drawable/ic_documents"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/space_8"
                            android:text="Review Remarks"
                            android:textColor="@color/create_booking_text_secondary"
                            android:textSize="@dimen/text_15"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <View
                        android:layout_width="@dimen/space_30"
                        android:layout_height="@dimen/space_3"
                        android:layout_marginStart="@dimen/space_34"
                        android:layout_marginTop="@dimen/space_4"
                        android:background="@color/section_requestor" />

                    <EditText
                        android:id="@+id/etReviewRemarks"
                        style="@style/CreateBookingEditText"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_12"
                        android:drawableStart="@drawable/ic_documents"
                        android:gravity="top|start"
                        android:hint="Remarks (Optional for approve; required for reject/send back/delete)"
                        android:inputType="textMultiLine|textCapSentences"
                        android:maxLines="5"
                        android:minLines="3" />

                </LinearLayout>

                <!-- MESSAGE -->
                <TextView
                    android:id="@+id/tvMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/space_12"
                    android:background="@drawable/bg_create_booking_info"
                    android:drawableStart="@android:drawable/ic_dialog_info"
                    android:drawablePadding="@dimen/space_8"
                    android:padding="@dimen/space_12"
                    android:textColor="@color/create_booking_error"
                    android:textSize="@dimen/text_12"
                    android:visibility="gone" />

                <!-- BUTTONS -->
                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateBooking"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_52"
                    android:layout_marginTop="@dimen/space_14"
                    android:background="@drawable/bg_create_booking_primary_button"
                    android:text="Create Booking"
                    android:textAllCaps="false"
                    android:textColor="@color/white"
                    android:textSize="@dimen/text_15"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnCreateBookingAndMail"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_create_booking_outline_button"
                    android:text="Create Booking and Mail"
                    android:textAllCaps="false"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnFillDummy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_create_booking_outline_button"
                    android:text="Fill Dummy Data (Dev Only)"
                    android:textAllCaps="false"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnSendBackBooking"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_create_booking_outline_button"
                    android:text="Send Back"
                    android:textAllCaps="false"
                    android:textColor="@color/create_booking_outline_text"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <androidx.appcompat.widget.AppCompatButton
                    android:id="@+id/btnDeleteBookingRequest"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/space_50"
                    android:layout_marginTop="@dimen/space_10"
                    android:background="@drawable/bg_create_booking_danger_outline_button"
                    android:text="Delete Request"
                    android:textAllCaps="false"
                    android:textColor="@color/error_red"
                    android:textSize="@dimen/text_14"
                    android:textStyle="bold"
                    android:visibility="gone" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/appToolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="@color/info_blue"
        app:menu="@menu/menu_landing_toolbar"
        app:title="@string/app_name"
        app:titleCentered="true"
        app:titleTextColor="@color/white" />

</FrameLayout>
